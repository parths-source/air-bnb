<% layout('layouts/boilerplate') -%>

<div class="container mt-5 mb-5">

    <div class="row justify-content-center">

        <div class="col-lg-9 col-md-11">

            <!-- Page Heading -->
            <div class="mb-4">
                <h1 class="fw-bold">Listing Details</h1>
                <p class="text-muted">
                    Have a look at this beautiful property.
                </p>
            </div>

            <!-- Listing Card -->
            <div class="card shadow-sm border-0 rounded-4 overflow-hidden">

                <!-- Image -->
                <img
                    src="<%= listing.image.url %>"
                    class="card-img-top"
                    alt="listing image"
                    style="height: 400px; object-fit: cover;"
                >

                <!-- Details -->
                <div class="card-body p-4 p-md-5">

                    <!-- Title -->
                    <h2 class="fw-bold mb-3">
                        <%= listing.title %>
                    </h2>

                    <!-- Location -->
                    <p class="text-muted mb-4">
                        <i class="fa-solid fa-location-dot"></i>
                        <%= listing.location %>
                    </p>

                    <hr>

                    <!-- Description -->
                    <div class="mt-4">
                        <h5 class="fw-bold">About this place</h5>

                        <p class="text-muted">
                            <%= listing.description %>
                        </p>
                    </div>

                    <!-- Price -->
                    <div class="mt-4">
                        <h5 class="fw-bold">Price</h5>

                        <h3 class="fw-bold">
                            ₹<%= listing.price %>
                            <small class="text-muted fs-6"> / night</small>
                        </h3>
                    </div>

                    <!-- Buttons -->
                    <div class="d-flex gap-3 mt-5">

                        <!-- Edit -->
                        <a
                            href="/listings/<%= listing._id %>/edit"
                            class="btn btn-dark px-4"
                        >
                            <i class="fa-solid fa-pen-to-square"></i>
                            Edit
                        </a>

                        <!-- Delete -->
                        <form
                            action="/listings/<%= listing._id %>?_method=DELETE"
                            method="POST"
                        >
                            <button
                                type="submit"
                                class="btn btn-outline-danger px-4"
                            >
                                <i class="fa-solid fa-trash"></i>
                                Delete
                            </button>
                        </form><br><br>

                    
                    
                    </div>
                    <div class="review-form">
                    <h4>Leave a Review</h4>

                    <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">

                        <div class="rating">
                        <input type="radio" name="review[rating]" value="5" id="star5">
                        <label for="star5">★</label>

                        <input type="radio" name="review[rating]" value="4" id="star4">
                        <label for="star4">★</label>

                        <input type="radio" name="review[rating]" value="3" id="star3">
                        <label for="star3">★</label>

                        <input type="radio" name="review[rating]" value="2" id="star2">
                        <label for="star2">★</label>

                        <input type="radio" name="review[rating]" value="1" id="star1">
                        <label for="star1">★</label>
                     </div>

                     <textarea
                        name="review[comment]"
                        placeholder="Write your review..."
                        required></textarea>

                       <button type="submit">Submit</button>

                    </form>
                </div>

<style>
.review-form {
    width: 350px;
    padding: 20px;
    border: 1px solid #ddd;
    border-radius: 12px;
}

.review-form h4 {
    margin-bottom: 10px;
}

.rating {
    display: flex;
    flex-direction: row-reverse;
    justify-content: flex-end;
}

.rating input {
    display: none;
}

.rating label {
    font-size: 25px;
    color: #ddd;
    cursor: pointer;
}

.rating label:hover,
.rating label:hover ~ label,
.rating input:checked ~ label {
    color: #ffc107;
}

.review-form textarea {
    width: 100%;
    height: 80px;
    margin-top: 10px;
    padding: 10px;
    border: 1px solid #ddd;
    border-radius: 8px;
    resize: none;
}

.review-form button {
    margin-top: 10px;
    padding: 8px 18px;
    border: none;
    border-radius: 7px;
    background: #ff385c;
    color: white;
    cursor: pointer;
}
</style>

                
<h4 class="mb-4"><b>All Reviews</b></h4>

<div class="row">
    <% for(review of listing.reviews) { %>

        <div class="col-md-6 mb-4">
            <div class="card review-card h-100">
                <div class="card-body">

                    <p class="card-text">
                        "<%= review.comment %>"
                    </p>

                    <div class="review-rating">
                        <% for(let i = 1; i <= 5; i++) { %>
                            <% if(i <= review.rating) { %>
                                <span class="star">★</span>
                            <% } else { %>
                                <span class="empty-star">★</span>
                            <% } %>
                        <% } %>
                    </div>

                    <small class="text-muted">
                        Rating: <%= review.rating %>/5
                    </small>

                </div>
            </div>
        </div>

    <% } %>
</div>

<style>
    .review-card {
        border: none;
        border-radius: 12px;
        box-shadow: 0 3px 12px rgba(0, 0, 0, 0.08);
    }

    .review-card:hover {
        transform: translateY(-3px);
        transition: 0.2s;
    }

    .review-card .card-text {
        color: #444;
        font-size: 16px;
        margin-bottom: 12px;
    }

    .star {
        color: #ffc107;
        font-size: 20px;
    }

    .empty-star {
        color: #ddd;
        font-size: 20px;
    }
</style>
