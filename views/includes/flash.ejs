<% if (typeof success !== "undefined" && success && success.length) { %>
	<div class="flash-message flash-success" role="alert">
		<span class="flash-icon">✓</span>
		<div>
			<p>Success</p>
			<strong><%= success[0] %></strong>
		</div>
		<button class="flash-close" type="button" aria-label="Close" onclick="this.parentElement.remove()">&times;</button>
	</div>
<% } %>

<% if (typeof error !== "undefined" && error && error.length) { %>
	<div class="flash-message flash-error" role="alert">
		<span class="flash-icon">!</span>
		<div>
			<strong>Something went wrong</strong>
			<p><%= error[0] %></p>
		</div>
		<button class="flash-close" type="button" aria-label="Close" onclick="this.parentElement.remove()">&times;</button>
	</div>
<% } %>

<style>
	.auth-flash { position: fixed; top: 18px; left: 50%; z-index: 10; width: min(calc(100% - 48px), 680px); transform: translateX(-50%); }
	.auth-flash .flash-message { margin: 0; }
	.flash-message { position: relative; display: flex; align-items: flex-start; gap: 12px; max-width: 680px; margin: 18px auto; padding: 16px 42px 16px 16px; border: 1px solid; border-radius: 14px; box-shadow: 0 8px 24px rgba(0,0,0,.08); animation: flash-in .35s ease-out; }
	.flash-success { color: #166534; background: #f0fdf4; border-color: #86efac; }
	.flash-error { color: #991b1b; background: #fef2f2; border-color: #fca5a5; }
	.flash-icon { display: grid; place-items: center; flex: 0 0 25px; height: 25px; border-radius: 50%; color: #fff; font-weight: 700; }
	.flash-success .flash-icon { background: #16a34a; }
	.flash-error .flash-icon { background: #dc2626; }
	.flash-message strong { display: block; margin-bottom: 3px; }
	.flash-message p { margin: 0; font-size: .94rem; }
	.flash-close { position: absolute; top: 10px; right: 12px; border: 0; background: transparent; color: inherit; cursor: pointer; font-size: 22px; line-height: 1; opacity: .7; }
	.flash-close:hover { opacity: 1; }
	@keyframes flash-in { from { opacity: 0; transform: translateY(-8px); } to { opacity: 1; transform: translateY(0); } }
</style>
