<!doctype html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Log in | STAYORA</title>
	<style>
		:root { font-family: "DM Sans", Arial, sans-serif; color: #20303c; background: #fffdf8; }
		* { box-sizing: border-box; }
		body { min-height: 100vh; margin: 0; display: grid; place-items: center; padding: 24px; }
		.card { width: min(100%, 420px); padding: 40px; background: #fff; border-radius: 18px; box-shadow: 0 18px 50px #174e5820; }
		.brand { margin: 0 0 8px; color: #c55b3f; font-family: Georgia, serif; font-size: 13px; font-weight: bold; letter-spacing: 1.5px; text-transform: uppercase; }
		h1 { margin: 0 0 10px; font-size: 30px; }
		.subtitle { margin: 0 0 28px; color: #64748b; line-height: 1.5; }
		label { display: block; margin: 18px 0 8px; font-size: 14px; font-weight: bold; }
		input { width: 100%; padding: 13px; border: 1px solid #cbd5e1; border-radius: 9px; font-size: 15px; }
		input:focus { outline: 2px solid #99d5d0; border-color: #0f766e; }
		button { width: 100%; margin-top: 26px; padding: 14px; border: 0; border-radius: 9px; color: white; background: #24443d; font-size: 16px; font-weight: bold; cursor: pointer; }
		button:hover { background: #c55b3f; }
		.signup { margin: 22px 0 0; color: #64748b; text-align: center; font-size: 14px; }
		.signup a { color: #0f766e; font-weight: bold; text-decoration: none; }
		.signup a:hover { text-decoration: underline; }
	</style>
</head>
<body>
	<div class="auth-flash"><%- include("includes/flash") %></div>
	<main class="card">
		<p class="brand">STAYORA</p>
		<h1>Welcome back</h1>
		<p class="subtitle">Log in to continue planning your next adventure.</p>
		<form action="/login" method="POST">
			<label for="username">Username</label>
			<input id="username" name="username" type="username" placeholder="Enter your username" autocomplete="username" required>

			<label for="password">Password</label>
			<input id="password" name="password" type="password" placeholder="Enter your password" autocomplete="current-password" required>

			<button type="submit">Log in</button>
		</form>
		<p class="signup">Don't have an account? <a href="/signup">Sign up</a></p>
	</main>
</body>
</html>