
<% layout('layouts/boilerplate') -%>

<div class="container mt-5 mb-5">

    <div class="row justify-content-center">

        <div class="col-lg-7 col-md-9">

            <!-- Heading -->

            <div class="mb-4">

                <p class="page-eyebrow">Share your space</p>
                <h1 class="fw-bold">Create a new listing</h1>

                <p class="text-muted">
                    Give travelers a clear, inviting picture of what makes your place special.
                </p>

            </div>


            <!-- Form -->

            <div class="card form-shell shadow-sm border-0 rounded-4">

                <div class="card-body p-4 p-md-5">

                    <form action="/listings" method="POST" novalidate class="needs-validation" enctype="multipart/form-data">

                        <!-- Title -->

                        <div class="mb-4">

                            <label for="title" class="form-label fw-semibold">
                                Title
                            </label>

                            <input
                                type="text"
                                id="title"
                                name="listing[title]"
                                class="form-control"
                                placeholder="Give your listing a memorable title"
                                required
                            >

                            <div class="invalid-feedback">
                                Please enter a title.
                            </div>

                        </div>


                        <!-- Location -->

                        <div class="mb-4">

                            <label for="location" class="form-label fw-semibold">
                                Location
                            </label>

                            <input
                                type="text"
                                id="location"
                                name="listing[location]"
                                class="form-control"
                                placeholder="City, neighborhood, or destination"
                                required
                            >

                            <div class="invalid-feedback">
                                Please enter a location.
                            </div>

                        </div>


                        <!-- Description -->

                        <div class="mb-4">

                            <label for="description" class="form-label fw-semibold">
                                Description
                            </label>

                            <textarea
                                id="description"
                                name="listing[description]"
                                class="form-control"
                                rows="5"
                                placeholder="Tell guests what they will love about staying here..."
                                required
                            ></textarea>

                            <div class="invalid-feedback">
                                Please enter a description.
                            </div>

                        </div>


                        <!-- Price -->

                        <div class="mb-4">

                            <label for="price" class="form-label fw-semibold">
                                Price
                            </label>

                            <div class="input-group">

                                <span class="input-group-text">₹</span>

                                <input
                                    type="number"
                                    id="price"
                                    name="listing[price]"
                                    class="form-control"
                                    placeholder="Price per night"
                                    required
                                >

                                <div class="invalid-feedback">
                                    Please enter a valid price.
                                </div>

                            </div>

                        </div>


                        <!-- Image -->

                        <div class="mb-4">

                            <label for="image" class="form-label fw-semibold">
                                Upload your listing
                            </label>

                            <input
                                type="file"
                                id="image"
                                name="listing[image]"
                                class="form-control"
                                placeholder="Paste a high-quality image URL"
                            >

                        </div>


                        

                        <!-- Submit -->

                        <button
                            type="submit"
                            class="btn btn-dark w-100 py-2"
                        >
                            Publish listing
                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>
