

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9">

            <!-- Heading -->
            <div class="mb-4">
                <p class="page-eyebrow">Keep your space up to date</p>
                <h1 class="fw-bold">Edit your listing</h1>
                <p class="text-muted">
                    Refresh the details so guests always know what to expect.
                </p>
            </div>

            <!-- Form Card -->
            <div class="card form-shell shadow-sm border-0 rounded-4">
                <div class="card-body p-4 p-md-5">

                    <form
                        action="/listings/<%= listing._id %>?_method=PUT"
                        method="POST" novalidate class="needs-validation"
                    >

                        <!-- Title -->
                        <div class="mb-4">
                            <label for="title" class="form-label fw-semibold">
                                Title
                            </label>

                            <input
                                type="text"
                                id="title"
                                name="listing[title]"
                                class="form-control"
                                value="<%= listing.title %>"
                                required
                            >
                            <div class="invalid-feedback">
                                Please enter a title.
                            </div>
                        </div>

                        <!-- Location -->
                        <div class="mb-4">
                            <label for="location" class="form-label fw-semibold">
                                Location
                            </label>

                    <% layout('layouts/boilerplate') -%>        <input
                                type="text"
                                id="location"
                                name="listing[location]"
                                class="form-control"
                                value="<%= listing.location %>"
                                required
                            >
                        </div>

                        <!-- Description -->
                        <div class="mb-4">
                            <label for="description" class="form-label fw-semibold">
                                Description
                            </label>

                            <textarea
                                id="description"
                                name="listing[description]"
                                class="form-control"
                                rows="5"
                                required
                            ><%= listing.description %></textarea>
                        </div>

                        <!-- Price -->
                        <div class="mb-4">
                            <label for="price" class="form-label fw-semibold">
                                Price
                            </label>

                            <div class="input-group">
                                <span class="input-group-text">₹</span>

                                <input
                                    type="number"
                                    id="price"
                                    name="listing[price]"
                                    class="form-control"
                                    value="<%= listing.price %>"
                                    required
                                >
                            </div>
                        </div>

                        <!-- Image -->
                        <div class="mb-4">
                          <label for="image" class="form-label fw-semibold">
                          Image URL
                          </label>

                          <input
                            type="text"
                            id="image"
                            name="listing[image][url]"
                            class="form-control"
                            value="<%= listing.image.url %>"
                          >

                          <input
                          type="hidden"
                          name="listing[image][filename]"
                          value="<%= listing.image.filename %>"
                          >
                        </div>
                        <!-- Update Button -->
                        <button
                            type="submit"
                            class="btn btn-dark w-100 py-2"
                        >
                            Save changes
                        </button>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div> 