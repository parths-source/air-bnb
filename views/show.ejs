
<% layout('layouts/boilerplate') -%>

<div class="container mt-5 mb-5">

    <div class="row justify-content-center">

        <div class="col-lg-9 col-md-11">

            <!-- Page Heading -->
            <div class="mb-4">
                <p class="page-eyebrow">Your next destination</p>
                <h1 class="fw-bold">Discover this stay</h1>

                <p class="text-muted">
                    Take a closer look at everything this place has to offer.
                </p>
            </div>


            <!-- Listing Card -->
            <div class="card listing-detail shadow-sm border-0 rounded-4 overflow-hidden">

                <!-- Image -->
                <img
                    src="<%= listing.image.url %>"
                    class="card-img-top"
                    alt="listing image"
                    style="height: 400px; object-fit: cover;"
                >

                <% if (averageRating) { %>
                    <div class="listing-average-rating px-4 py-3" aria-label="Average rating: <%= averageRating %> out of 5">
                        <span class="starability-result" data-rating="<%= averageRating %>"></span>
                        <span class="text-muted"><%= averageRating %>/5 from <%= listing.reviews.length %> review<%= listing.reviews.length === 1 ? "" : "s" %></span>
                    </div>
                <% } %>

                <div class="card-body p-4 p-md-5">
                    <h2 class="fw-bold mb-3"><%= listing.title %></h2>
                    <p class="text-muted mb-4">
                        <i class="fa-solid fa-location-dot"></i>
                        <%= listing.location %>
                    </p>
                    <p><i>Owned by: <b><%= listing.owner ? listing.owner.username : "STAYORA host" %></b></i></p>
                    <hr>

                    <div class="mt-4">
                        <h5 class="fw-bold">About this stay</h5>
                        <p class="text-muted"><%= listing.description %></p>
                    </div>

                    <div class="mt-4">
                        <h5 class="fw-bold">Nightly rate</h5>
                        <h3 class="fw-bold">
                            ₹<%= listing.price %>
                            <small class="text-muted fs-6">/ night</small>
                        </h3>
                    </div>

                    <% if(currentUser && listing.owner && currentUser._id.equals(listing.owner._id) ){ %>
                    <!-- Buttons -->
                    <div class="d-flex gap-3 mt-5">

                        <!-- Edit -->
                        <a
                            href="/listings/<%= listing._id %>/edit"
                            class="btn btn-dark px-4"
                        >
                            <i class="fa-solid fa-pen-to-square"></i>
                            Edit
                        </a>


                        <!-- Delete -->
                        <form
                            action="/listings/<%= listing._id %>?_method=DELETE"
                            method="POST"
                        >
                            <button
                                type="submit"
                                class="btn btn-outline-danger px-4"
                            >
                                <i class="fa-solid fa-trash"></i>
                                Delete
                            </button>
                        </form>

                    </div>
                    <%} %>

                    <!-- Listing location -->
                    <section class="listing-map mt-5" aria-labelledby="listing-map-title">
                        <h4 id="listing-map-title" class="mb-3">Where you'll stay</h4>
                        <div class="listing-map-frame">
                            <iframe
                                title="Map showing <%= listing.location %>"
                                src="https://www.google.com/maps?q=<%= encodeURIComponent([listing.location, listing.country].filter(Boolean).join(', ')) %>&output=embed"
                                loading="lazy"
                                referrerpolicy="no-referrer-when-downgrade"
                                allowfullscreen
                            ></iframe>
                        </div>
                    </section>


                    <!-- Review Form -->
                    <% if (currentUser) { %>
                    <div class="review-form mt-5">
                        <h4>Share your experience</h4>
                        <form action="/listings/<%= listing._id %>/reviews" method="POST">
                            <fieldset class="starability-slot">
                                <legend class="visually-hidden">Rate this listing</legend>
                                <input type="radio" id="review-rate5" name="review[rating]" value="5">
                                <label for="review-rate5" title="Amazing">5 stars</label>
                                <input type="radio" id="review-rate4" name="review[rating]" value="4">
                                <label for="review-rate4" title="Great">4 stars</label>
                                <input type="radio" id="review-rate3" name="review[rating]" value="3">
                                <label for="review-rate3" title="Good">3 stars</label>
                                <input type="radio" id="review-rate2" name="review[rating]" value="2">
                                <label for="review-rate2" title="Fair">2 stars</label>
                                <input type="radio" id="review-rate1" name="review[rating]" value="1" required>
                                <label for="review-rate1" title="Poor">1 star</label>
                                <span class="starability-focus-ring"></span>
                            </fieldset>
                            <textarea name="review[comment]" placeholder="Write your review..." required></textarea>
                            <button type="submit">Post review</button>
                        </form>
                    </div>
                    <% } %>

                    <!-- All Reviews -->
                    <div class="mt-5">

                        <h4 class="mb-4">
                            Guest reviews
                        </h4>


                        <div class="row">

                            <% for(review of listing.reviews) { %>

                                <div class="col-md-6 mb-4">

                                    <div class="card review-card h-100">

                                        <div class="card-body">

                                            <h4><strong><%= review.author ? review.author.username : "Anonymous guest" %></strong></h4>
                                            <p class="card-text">
                                                "<%= review.comment %>"
                                            </p>


                                            <div class="review-rating">

                                                <% for(let i = 1; i <= 5; i++) { %>

                                                    <% if(i <= review.rating) { %>

                                                        <span class="star">
                                                            ★
                                                        </span>

                                                    <% } else { %>

                                                        <span class="empty-star">
                                                            ★
                                                        </span>

                                                    <% } %>

                                                <% } %>

                                            </div>


                                            <small class="text-muted">
                                                Rating: <%= review.rating %>/5
                                            </small>
                                            <% if (currentUser && review.author && String(currentUser._id) === String(review.author._id)) { %>
                                                <form method="POST" action="/listings/<%=listing._id%>/reviews/<%=review._id%>?_method=DELETE">
                                                    <button type="submit" class="btn btn-sm btn-outline-secondary"><b>Remove review</b></button>
                                                </form>
                                            <% } %>

                                        </div>

                                    </div>

                                </div>

                            <% } %>

                        </div>

                    </div>


                    <style>

                        .review-card {
                            border: none;
                            border-radius: 12px;
                            box-shadow: 0 3px 12px rgba(0, 0, 0, 0.08);
                        }

                        .review-card:hover {
                            transform: translateY(-3px);
                            transition: 0.2s;
                        }

                        .review-card .card-text {
                            color: #444;
                            font-size: 16px;
                            margin-bottom: 12px;
                        }

                        .star {
                            color: #ffc107;
                            font-size: 20px;
                        }

                        .empty-star {
                            color: #ddd;
                            font-size: 20px;
                        }

                    </style>

                </div>

            </div>

        </div>

    </div>

</div>
```
