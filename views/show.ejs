<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= listing.title %></title>
    <ul>
        <li>Title: <%= listing.title %></li>
        <li>Location: <%= listing.location %></li>
        <li>Description: <%= listing.description %></li>
        <li>Price: &#8377;<%= listing.price %></li>
        <li>Image: <img src="<%= listing.image.url %>" alt="<%= listing.image.filename %>" width="200"></li>
    </ul>
    <a href="/listings/<%= listing._id %>/edit">EDIT</a>
    <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST" style="display:inline;">
        <button type="submit">DELETE</button>
    </form>
</head>
<body>
    
</body>
</html>